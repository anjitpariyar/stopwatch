{
  "name": "unlocked",
  "main": "index.ts",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "prebuild:android": "expo prebuild --platform android --clean --no-install",
    "build:apk:local": "cd android && ./gradlew assembleRelease",
    "build:apk": "eas build --profile preview --platform android",
    "build:dev": "eas build --profile development --platform android",
    "assets": "node scripts/generate-assets.js",
    "build:store": "eas build --profile store --platform android",
    "submit:store": "eas submit --profile production --platform android --latest"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/elements": "^2.9.10",
    "@react-navigation/native": "^7.1.33",
    "@tailwindcss/postcss": "^4.3.0",
    "clsx": "^2.1.1",
    "expo": "~55.0.27",
    "expo-constants": "~55.0.16",
    "expo-dev-client": "~55.0.36",
    "expo-device": "~55.0.18",
    "expo-font": "~55.0.8",
    "expo-glass-effect": "~55.0.11",
    "expo-image": "~55.0.11",
    "expo-linking": "~55.0.16",
    "expo-router": "~55.0.16",
    "expo-splash-screen": "~55.0.22",
    "expo-status-bar": "~55.0.6",
    "expo-symbols": "~55.0.9",
    "expo-system-ui": "~55.0.19",
    "expo-updates": "~55.0.25",
    "expo-web-browser": "~55.0.17",
    "nativewind": "^5.0.0-preview.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-android-widget": "^0.20.3",
    "react-native-css": "^3.0.7",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~5.9.2"
